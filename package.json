{
  "name": "babel-plugin-ot-ignore",
  "version": "1.0.0",
  "description": "A Babel plugin thad adds configurable data-ot-ignore and className='optanon-category-C0001' to all React elements which have src attribute",
  "keywords": [
    "babel",
    "plugin",
    "react",
    "ot-ignore",
    "consent",
    "gdpr",
    "compliance",
    "optanon",
    "OneTrust"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzzarius/babel-plugin-ot-ignore.git"
  },
  "main": "./babel-plugin-ot-ignore.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:dangerous": "biome lint --write --unsafe .",
    "biome:migrate": "biome migrate --write"
  },
  "author": "Darius Zivertas",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@biomejs/biome": "^2.6.8",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2"
  },
  "peerDependencies": {
    "@babel/core": "^7.22.5 || ^8.0.0",
    "@babel/preset-react": "^7.22.5 || ^8.0.0"
  }
}
